{
  "name": "reels-filtr",
  "version": "0.3.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": "^24.3.0 || ^26.0.0"
  },
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:ios": "expo prebuild --clean --platform ios",
    "prebuild:guard": "REELS_NATIVE_BLOCKING=1 expo prebuild --clean --platform ios",
    "ios:guard": "REELS_NATIVE_BLOCKING=1 expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:native": "swift test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "jsdom": "26.1.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
