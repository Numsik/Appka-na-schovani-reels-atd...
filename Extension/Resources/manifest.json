{
  "manifest_version": 3,
  "name": "Reels filtr",
  "description": "Skryje odkazy na Reels ve webovém Instagramu.",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "css": ["filter.css"],
      "js": ["filter.js"],
      "run_at": "document_start"
    }
  ]
}
